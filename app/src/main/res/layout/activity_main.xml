<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quizz gestion du stress "
        tools:layout_editor_absoluteX="131dp"
        tools:layout_editor_absoluteY="49dp" />

    <EditText
        android:id="@+id/editTextPhone3"
        android:layout_width="55dp"
        android:layout_height="22dp"
        android:ems="10"
        android:inputType="phone"
        tools:layout_editor_absoluteX="181dp"
        tools:layout_editor_absoluteY="272dp" />

    <EditText
        android:id="@+id/editTextPhone2"
        android:layout_width="109dp"
        android:layout_height="23dp"
        android:ems="10"
        android:inputType="phone"
        tools:layout_editor_absoluteX="181dp"
        tools:layout_editor_absoluteY="228dp" />

    <TextView
        android:id="@+id/textView6"
        android:layout_width="51dp"
        android:layout_height="22dp"
        android:text="Age"
        tools:layout_editor_absoluteX="130dp"
        tools:layout_editor_absoluteY="272dp" />

    <EditText
        android:id="@+id/editTextPhone"
        android:layout_width="109dp"
        android:layout_height="23dp"
        android:ems="10"
        android:inputType="phone"
        tools:layout_editor_absoluteX="179dp"
        tools:layout_editor_absoluteY="187dp" />

    <TextView
        android:id="@+id/textView4"
        android:layout_width="48dp"
        android:layout_height="24dp"
        android:text="Nom"
        tools:layout_editor_absoluteX="131dp"
        tools:layout_editor_absoluteY="187dp" />

    <TextView
        android:id="@+id/textView7"
        android:layout_width="50dp"
        android:layout_height="23dp"
        android:text="Prénom"
        tools:layout_editor_absoluteX="130dp"
        tools:layout_editor_absoluteY="228dp" />

    <Button
        android:id="@+id/button"
        android:layout_width="81dp"
        android:layout_height="46dp"
        android:text="Start"
        tools:layout_editor_absoluteX="165dp"
        tools:layout_editor_absoluteY="580dp" />

    <TextView
        android:id="@+id/textView9"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quelque questions sur toi avant de commencé :)"
        tools:layout_editor_absoluteX="57dp"
        tools:layout_editor_absoluteY="122dp" />

    <RadioGroup
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:layout_editor_absoluteX="139dp"
        tools:layout_editor_absoluteY="324dp"
        tools:ignore="MissingConstraints">

        <RadioButton
            android:id="@+id/radioButton2"
            android:layout_width="match_parent"
            android:layout_height="37dp"
            android:text="Homme" />

        <RadioButton
            android:id="@+id/radioButton"
            android:layout_width="121dp"
            android:layout_height="35dp"
            android:text="Femme" />
    </RadioGroup>

    <TextView
        android:id="@+id/textView10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Te considères-tu comme quelqu'un de stressé ? "
        tools:layout_editor_absoluteX="69dp"
        tools:layout_editor_absoluteY="461dp" />

    <Switch
        android:id="@+id/switch3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Non/Oui"
        tools:layout_editor_absoluteX="156dp"
        tools:layout_editor_absoluteY="504dp" />

</androidx.constraintlayout.widget.ConstraintLayout>