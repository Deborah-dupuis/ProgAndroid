<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFC5D3"
    android:padding="16dp"
    tools:context=".MainActivity5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">


        <ImageView
            android:id="@+id/logoStress"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:src="@drawable/logo_zen"
            android:contentDescription="Zen logo" />


        <TextView
            android:id="@+id/tvTitle5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fréquence & Intensité du stress"
            android:textColor="#1b5b9a"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"
            android:gravity="center" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="À quelle fréquence ressens-tu du stress dans ta vie quotidienne ?"
            android:textColor="#37474F"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rgFrequence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbFrequence1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rarement, presque jamais"
                android:tag="0" />

            <RadioButton
                android:id="@+id/rbFrequence2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Parfois, selon les périodes"
                android:tag="1" />

            <RadioButton
                android:id="@+id/rbFrequence3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Souvent, plusieurs fois par semaine"
                android:tag="2" />

            <RadioButton
                android:id="@+id/rbFrequence4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Presque tout le temps"
                android:tag="3" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Te sens-tu souvent débordé·e par tes responsabilités ?"
            android:textColor="#37474F"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinnerDeborde"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:spinnerMode="dropdown"
            android:background="@android:drawable/btn_dropdown" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ressens-tu régulièrement des tensions physiques liées au stress ?"
            android:textColor="#37474F"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/seekTension"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="3" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="space_between">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jamais" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Parfois" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Souvent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Presque tous les jours" />
        </LinearLayout>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Globalement, comment évalues-tu ta gestion du stress au quotidien ?"
            android:textColor="#37474F"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinnerGestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:spinnerMode="dropdown"
            android:background="@android:drawable/btn_dropdown" />


        <Button
            android:id="@+id/btnSuivant4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Suivant"
            android:textAllCaps="false"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="32dp"
            android:backgroundTint="#A5D6A7"
            android:textColor="#ffffff"
            android:elevation="3dp" />

    </LinearLayout>
</ScrollView>
