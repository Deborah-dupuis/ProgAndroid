<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAE3B9"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/logoEmotion"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:contentDescription="lotus_logo"
            android:src="@drawable/lotus_logo" />

        <TextView
            android:id="@+id/tvTitle4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:fontFamily="sans-serif-medium"
            android:text="Expression & Régulation émotionnelle"
            android:textColor="#37474F"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card_pastel"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp"
                android:text="Quand quelqu’un te critique, tu :"
                android:textColor="#37474F"
                android:textSize="18sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgCritique"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/rbCritique1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Écoutes et réponds calmement" />

                <RadioButton
                    android:id="@+id/rbCritique2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Es un peu agacé·e mais ça passe" />

                <RadioButton
                    android:id="@+id/rbCritique3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Exploses un peu" />

                <RadioButton
                    android:id="@+id/rbCritique4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Exploses complètement et râles longtemps" />
            </RadioGroup>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card_pastel"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp"
                android:text="Arrives-tu à exprimer tes émotions de manière saine (parler, écrire, activité créative, etc.) ?"
                android:textColor="#37474F"
                android:textSize="18sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgExpression"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/rbExpression1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Oui, très facilement" />

                <RadioButton
                    android:id="@+id/rbExpression2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Oui, mais pas systématiquement" />

                <RadioButton
                    android:id="@+id/rbExpression3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rarement, j’ai du mal à le faire" />

                <RadioButton
                    android:id="@+id/rbExpression4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Non, je garde tout pour moi" />
            </RadioGroup>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card_pastel"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp"
                android:text="Quand quelqu’un te demande “ça va ?”, tu..."
                android:textColor="#37474F"
                android:textSize="18sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgCava"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/rbCava1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Réponds honnêtement, même si ça ne va pas" />

                <RadioButton
                    android:id="@+id/rbCava2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dis “ça va” pour ne pas déranger, mais tu bouillonnes un peu" />

                <RadioButton
                    android:id="@+id/rbCava3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fais semblant que tout va bien alors que non" />

                <RadioButton
                    android:id="@+id/rbCava4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lances un grand monologue dramatique" />
            </RadioGroup>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_pastel"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp"
                android:text="Quand tu ressens une émotion forte (colère, peur, tristesse...) tu..."
                android:textColor="#37474F"
                android:textSize="18sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgEmotionForte"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/rbEmotion1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Prends un moment pour respirer et comprendre ce que tu ressens" />

                <RadioButton
                    android:id="@+id/rbEmotion2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Essaies de passer à autre chose sans trop y penser" />

                <RadioButton
                    android:id="@+id/rbEmotion3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gardes tout pour toi jusqu’à ce que ça ressorte plus tard" />

                <RadioButton
                    android:id="@+id/rbEmotion4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Exploses directement, sans filtre" />
            </RadioGroup>
        </LinearLayout>

        <Button
            android:id="@+id/btnSuivant4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="32dp"
            android:backgroundTint="#A5D6A7"
            android:elevation="3dp"
            android:text="Suivant"
            android:textAllCaps="false"
            android:textColor="#ffffff" />

    </LinearLayout>
</ScrollView>
